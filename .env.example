# Variáveis de ambiente — copie este arquivo para .env.local e preencha os valores

# URL do projeto Supabase (encontrada em: Supabase Dashboard → Settings → API → Project URL)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave service_role — NUNCA exponha no frontend ou comite no git
# Encontrada em: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── Credenciais de MÁQUINA (v6.0.0) — a que verifica não escreve; a que ingere não lê ───
# São USUÁRIOS do Supabase Auth (verificador@janus.interno, ingestor@janus.interno) que fazem
# login com estas senhas e recebem um token ES256 de 1 h; o custom_access_token_hook (0275)
# troca o claim `role` para o papel do Postgres (verificador/ingestor). Desativar o usuário
# revoga na hora. Definir/rotacionar: node scripts/credencial/definir-senha-maquina.mjs <papel> --gravar
# Runbook: docs/runbooks/credenciais-maquina-runbook.md
SUPABASE_VERIFICADOR_SENHA=   # suíte de contrato, medições (só local)
SUPABASE_INGESTOR_SENHA=      # rota /api/ingestao (local + Vercel)

# Chave anon — usada pelo cliente do frontend (Next.js)
# Encontrada em: Supabase Dashboard → Settings → API → anon (public)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── E-mail (SMTP) — envio da senha provisória no fluxo de acesso (v4.24.0) ───
# OPCIONAL. Sem estas variáveis, a senha provisória continua exibida na tela (fallback);
# preenchê-las no .env.local (e no ambiente da Vercel) habilita o envio automático.
# Office 365: SMTP_HOST=smtp.office365.com · SMTP_PORT=587 · SMTP_SECURE=false (STARTTLS).
# SMTP_FROM (remetente) normalmente deve ser IGUAL ao SMTP_USER no Office 365.
# NUNCA comite valores reais aqui — só no .env.local (gitignored) / Vercel.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Faturamento Fase 4a — envio de e-mail de fatura. E-mail SAI DE VERDADE (não há sandbox);
# o "sandbox do e-mail" é o MODO TESTE, com override de destinatário. Server-only.
# EMAIL_MODO: qualquer valor != 'real' (incl. ausente) = teste (fail-safe). 'real' só na Fase 4b.
# EMAIL_TESTE_DESTINO: OBRIGATÓRIO em teste — TODOS os e-mails vão para ele. Sem ele, o envio
# é recusado (fail-closed), nunca vaza para o cliente.
EMAIL_MODO=teste
EMAIL_TESTE_DESTINO=

# ─── URL base do app — link "Acessar a plataforma" no e-mail (v4.24.1) ───
# OPCIONAL. URL canônica do app (incl. domínio próprio), usada no botão do e-mail de senha.
# Sem ela, cai em VERCEL_PROJECT_PRODUCTION_URL (auto da Vercel) ou omite o botão (e-mail
# segue válido). Defina aqui (local) e na Vercel. Ex.: https://wt-finance.vercel.app
APP_BASE_URL=

# ─── Asaas — emissão de boletos do Faturamento Corporativo (v4.31.0, Fase 1b) ───
# SANDBOX-FIRST: sem ASAAS_BASE_URL, o app usa o SANDBOX (https://sandbox.asaas.com/api/v3) —
# nada é cobrado. PRODUÇÃO só ao definir ASAAS_BASE_URL=https://api.asaas.com/v3 (ação
# consciente). A tela SEMPRE mostra o ambiente; produção exige confirmação reforçada.
# ASAAS_API_KEY: chave de API do Asaas (Configurações → Integrações → API). É a chave do
# AMBIENTE correspondente (a do sandbox NÃO funciona em produção e vice-versa). Server-only:
# nunca vai ao cliente. NUNCA comite valores reais aqui — só no .env.local / Vercel.
ASAAS_API_KEY=
ASAAS_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# v5.10.0/D10-003 — chaves que o código LÊ e que faltavam neste arquivo. Só nome e
# comentário: NUNCA comite valores reais aqui (vão no .env.local / painel da Vercel).
# ─────────────────────────────────────────────────────────────────────────────

# Conexão DIRETA ao Postgres (não é o PostgREST). Usada pelo backup-gate
# (scripts/db-gate/lib.mjs) e pelos testes que provam RPC em transação revertida
# (skill banco-e-rpc §6). Sem ela esses testes se auto-pulam — a sonda
# src/lib/sonda-skipif-silencioso.test.ts existe justamente para isso não passar calado.
SUPABASE_DB_URL=

# API do Monde — espelho de vendas (src/lib/monde/client.ts). A KEY é segredo.
MONDE_API_URL=
MONDE_API_KEY=

# Segredo do agendamento. As rotas de ingestão (/api/monde/ingest, /api/cdi/ingest)
# autenticam o cron por `Authorization: Bearer $CRON_SECRET` NO HANDLER — o proxy.ts
# as isenta de sessão por isso (ADR-0153). Injetado pela Vercel nos Cron Jobs.
CRON_SECRET=

# Injetada pela VERCEL (não definir à mão em produção): URL de produção sem protocolo,
# usada como último fallback da base dos links de e-mail (src/lib/email/config.ts:57).
# Localmente prefira APP_BASE_URL.
VERCEL_PROJECT_PRODUCTION_URL=

# Só em CI/execução deliberada: REQUIRE_CONTRACT=1 torna OBRIGATÓRIAS as credenciais dos
# testes de contrato — sem elas a suíte FALHA em vez de pular blocos e parecer verde
# (lição v5.4.3). Não definir no .env.local do dia a dia.
REQUIRE_CONTRACT=

# ─── Alarme de ingestão (v6.0.0/M6) — destinatários REAIS, só usados em EMAIL_MODO=real ───
# Lista de e-mails separada por VÍRGULA (não ';' — essa é a regra do campo de cadastro de
# cliente). Em EMAIL_MODO=teste (default), todo alarme vai para EMAIL_TESTE_DESTINO e esta
# variável é ignorada. Em modo real, ausente/vazia = envio recusado (fail-closed).
INGESTAO_ALARME_DESTINOS=
