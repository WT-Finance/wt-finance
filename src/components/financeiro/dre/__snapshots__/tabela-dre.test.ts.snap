exports[`TabelaDre — markup congelado (guarda da visão Empresa) > caixa, ano corrente (Consolidado + Realizado, o default) 1`] = `"<div class="rounded-xl bg-surface p-5 shadow-sm"><div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1"><div class="flex items-center gap-1.5"><h2 class="text-[15px] font-semibold text-text-primary">Demonstrativo de Resultado por Fluxo de Caixa</h2><span class="relative inline-flex group/tip"><button type="button" aria-label="Prefixo das linhas: O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo." class="foco-neutro inline-flex h-3 w-3 items-center justify-center rounded-full border border-wt-border-strong text-[8px] font-semibold leading-none text-text-subtle ">?</button><span role="tooltip" class="pointer-events-none absolute left-0 top-5 z-20 invisible rounded bg-[var(--tooltip-bg)] px-2 py-1 text-2xs text-white whitespace-nowrap shadow-lg group-hover/tip:visible group-focus-within/tip:visible z-30 w-72 !whitespace-normal font-normal normal-case tracking-normal leading-snug">O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo.</span></span></div></div><div class="mb-4 flex flex-col gap-2"><div class="flex flex-wrap items-center gap-1.5"><button type="button" title="Visão mês a mês do ano selecionado" aria-pressed="false" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-50">Mensal</button><button type="button" aria-pressed="true" title="Visão ano a ano — marque quantos anos quiser nas pills abaixo" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transi