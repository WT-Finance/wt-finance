exports[`TabelaDre — markup congelado (guarda da visão Empresa) > caixa, sem dados (fail-safe) 1`] = `"<div class="rounded-xl bg-surface p-5 shadow-sm"><div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1"><div class="flex items-center gap-1.5"><h2 class="text-[15px] font-semibold text-text-primary">Demonstrativo de Resultado por Fluxo de Caixa</h2><span class="relative inline-flex group/tip"><button type="button" aria-label="Prefixo das linhas: O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo." class="foco-neutro inline-flex h-3 w-3 items-center justify-center rounded-full border border-wt-border-strong text-[8px] font-semibold leading-none text-text-subtle ">?</button><span role="tooltip" class="pointer-events-none absolute left-0 top-5 z-20 invisible rounded bg-[var(--tooltip-bg)] px-2 py-1 text-2xs text-white whitespace-nowrap shadow-lg group-hover/tip:visible group-focus-within/tip:visible z-30 w-72 !whitespace-normal font-normal normal-case tracking-normal leading-snug">O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo.</span></span></div></div><div class="mb-4 flex flex-wrap items-center gap-2"><button type="button" title="Ver o ano 2024" aria-pressed="false" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-50 disabled:opacity-50 disabled:cursor-not-allowed">2024</button><button type="button" title="Ver o ano 2025" aria-pressed="false" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-50 disabled:opacity-50 disabled:cursor-not-allowed">2025</button><button type="button" title="Ver o ano 2026" aria-pressed="true" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap  disabled:opacity-50 disabled:cursor-not-allowed" style="background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep)">2026</button></div><div class="rounded-lg border border-wt-border p-6 text-center "><p class="text-sm text-text-muted">Não foi possível carregar a DRE — tente recarregar.</p></div></div>"`;

exports[`TabelaDre — markup congelado (guarda da visão Empresa) > competência (semPrevisto, título e parâmetro próprios) 1`] = `"<div class="rounded-xl bg-surface p-5 shadow-sm"><div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1"><div class="flex items-center gap-1.5"><h2 class="text-[15px] font-semibold text-text-primary">Demonstrativo de Resultado por Competência</h2><span class="relative inline-flex group/tip"><button type="button" aria-label="Prefixo das linhas: O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo." class="foco-neutro inline-flex h-3 w-3 items-center justify-center rounded-full border border-wt-border-strong text-[8px] font-semibold leading-none text-text-subtle ">?</button><span role="tooltip" class="pointer-events-none absolute left-0 top-5 z-20 invisible rounded bg-[var(--tooltip-bg)] px-2 py-1 text-2xs text-white whitespace-nowrap shadow-lg group-hover/tip:visible group-focus-within/tip:visible z-30 w-72 !whitespace-normal font-normal normal-case tracking-normal leading-snug">O prefixo (+), (−), (+/−) ou (=) indica o papel da linha na leitura do demonstrativo, não o sinal do valor do período — esse aparece no próprio número, entre parênteses quando negativo. Categorias não levam prefixo.</span></span></div></div><div class="mb-4 flex flex-col gap-2"><div class="flex flex-wrap items-center gap-1.5"><button type="button" title="Visão mês a mês do ano selecionado" aria-pressed="false" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-50">Mensal</button><button type="button" aria-pressed="true" title="Visão ano a ano — marque quantos anos quiser nas pills abaixo" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap  disabled:opacity-50 disabled:cursor-not-allowed" style="background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep)">Consolidado</button></div><div class="flex flex-wrap items-center gap-2"><button type="button" title="Marcar 2024 — a seleção é cumulativa (um grupo de colunas por ano)" role="checkbox" aria-checked="false" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap border-zinc-200 text-zinc-500 hover:border-zinc-300 hover:bg-zinc-50 disabled:opacity-50 disabled:cursor-not-allowed">2024</button><button type="button" title="Desmarcar 2025 da comparação" role="checkbox" aria-checked="true" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap  disabled:opacity-50 disabled:cursor-not-allowed" style="background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep)">2025</button><button type="button" title="Desmarcar 2026 da comparação" role="checkbox" aria-checked="true" class="foco-neutro rounded-full border px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap  disabled:opacity-50 disabled:cursor-not-allowed" style="background:var(--brand-soft);border-color:var(--brand);color:var(--brand-deep)">2026</button><div class="ml-auto flex flex-wrap items-center gap-3"><button type="button" class="foco-neutro text-xs text-zinc-400 transition-colors hover:text-zinc-600 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-1.5" title="Abrir todas as contas de todos os blocos"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-up-down" aria-hidden="true"><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg>Expandir tudo</button><button type="button" class="foco-neutro text-xs text-zinc-400 transition-colors hover:text-zinc-600 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-1.5" title="Fechar todos os blocos — só a estrutura de resultado à vista"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-down-up" aria-hidden="true"><path d="m7 20 5-5 5 5"></path><path d="m7 4 5 5 5-5"></path></svg>Recolher tudo</button><button type="button" class="foco-neutro text-xs text-zinc-400 transition-colors hover:text-zinc-600 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-1.5" aria-pressed="false" title="Ocupar a tela inteira com o demonstrativo"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"></path><path d="M21 8V5a2 2 0 0 0-2-2h-3"></path><path d="M3 16v3a2 2 0 0 0 2 2h3"></path><path d="M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>Ver em tela cheia</button><button type="button" class="foco-neutro text-xs text-zinc-400 transition-colors hover:text-zinc-600 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-1.5" title="Baixar o demonstrativo em Excel — todas as linhas expandidas, nas abas Mensal e Consolidado"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-spreadsheet" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M8 13h2"></path><path d="M14 13h2"></path><path d="M8 17h2"></path><path d="M14 17h2"></path></svg>Exportar</button></div></div></div><div class="overflow-hidden rounded-lg border border-wt-border bg-band transition-opacity " aria-busy="false"><div class="pb-1.5 pr-1.5"><div class="relative isolate flex min-h-0 flex-1 flex-col"><div class="min-h-0 flex-1 overflow-auto scrollbar-none max-h-[80vh] pb-3.5"><div><table class="w-full border-separate border-spacing-0 text-[13px]" style="min-width:1082px"><thead class="sticky top-0 z-20 [&amp;_th]:bg-band"><tr><th rowSpan="2" class="sticky left-0 z-30 w-[330px] min-w-[330px] max-w-[330px] border-r border-r-wt-border-strong pl-3 pr-3 align-bottom pb-[7px] text-left text-[10px] font-semibold uppercase tracking-[0.09em] text-text-secondary border-b-[1.5px] border-b-wt-border-strong">Conta</th><th colSpan="6" title="Comparação na MESMA janela dos dois lados (jan a out) — um grupo de colunas por ano marcado" class="whitespace-nowrap px-3.5 py-1.5 text-right text-[10px] font-semibold uppercase tracking-[0.09em] text-text-secondary"><span class="sticky inline-flex items-center gap-1.5" style="right:14px">Realizado</span></th></tr><tr><th title="2025 — ano inteiro" class="h-[25px] whitespace-nowrap px-3.5 text-right text-[10px] font-semibold uppercase tracking-[0.09em] text-text-secondary border-b-[1.5px] border-b-wt-border-strong">2025</th><th title="AV — Análise Vertical: % sobre a Receita Bruta de Vendas do mesmo período. As linhas ACIMA da Receita Bruta não têm AV: elas são as parcelas que a formam, não parte dela. — 2025 inteiro" class="h-[25px] whitespace-nowrap px-3.5 text-right text-[10px] font-semibold uppercase tracking-[0.09em] text-text-subtle border-b-[1.5px] border-b-wt-border-strong">AV</th><th title="2025 na MESMA janela dos demais anos (jan a out)" class="h-[25px] whitespace-nowrap px-3.5 text-right text-[10px] font-semibold uppercase tracking-[0.09em] text-text-secondary border-b-[1.5px] border-b-wt-border-strong">YTD 25</th><th title="Variação do YTD de 2025 para 2026 (mesma janela: jan a out)" class="h-[25px] whitespace-nowra