# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Git worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# planilhas de dados (nunca commitar — contêm dados internos da empresa)
supabase/seed/data/*
!supabase/seed/data/.gitkeep
# Proteção contra vazamento de instalação de plugins de agentes
:USERPROFILE*
.agents/
.codexsuperpowers/
.superpowers/
/agent/
/brag-output/

# Config local do Claude Code (por máquina, nunca versionada)
.claude/settings.local.json

# Skills de vídeo instaladas por tooling externo (symlinks para .agents/skills — sem trailing
# slash de propósito: são symlinks, e `dir/` não casa symlink; skills do projeto ficam versionadas)
.claude/skills/hyperframes*
.claude/skills/embedded-captions
.claude/skills/faceless-explainer
.claude/skills/general-video
.claude/skills/graphic-overlays
.claude/skills/motion-graphics
.claude/skills/music-to-video
.claude/skills/pr-to-video
.claude/skills/product-launch-video
.claude/skills/remotion-to-hyperframes
.claude/skills/slideshow
.claude/skills/website-to-video
